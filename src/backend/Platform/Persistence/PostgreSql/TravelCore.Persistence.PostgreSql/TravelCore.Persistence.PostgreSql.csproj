    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TravelCore.Persistence.PostgreSql</RootNamespace>
    <AssemblyName>TravelCore.Persistence.PostgreSql</AssemblyName>
    <Description>Shared PostgreSQL / EF Core provider configuration for TravelCore (ADR 0001).</Description>
