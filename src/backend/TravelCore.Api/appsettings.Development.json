{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "Payment": {
    "Provider": {
      "DefaultProviderKey": "sandbox"
    },
    "Sandbox": {
      "Enabled": true,
      "HmacSecret": "DEV-ONLY-CHANGE-ME-sandbox-hmac-secret"
    },
    "Stripe": {
      "Enabled": false,
      "SecretKey": "",
      "WebhookSecret": "",
      "PublicBaseUrl": "http://localhost:5275",
      "SuccessUrl": "http://localhost:3000/en/payment/return?result=success",
      "CancelUrl": "http://localhost:3000/en/payment/return?result=cancel"
    }
  }
}
