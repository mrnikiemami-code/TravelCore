{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "Payment": {
    "Provider": {
      "DefaultProviderKey": "sandbox"
    },
    "Sandbox": {
      "Enabled": true,
      "HmacSecret": "DEV-ONLY-CHANGE-ME-sandbox-hmac-secret"
    }
  }
}
